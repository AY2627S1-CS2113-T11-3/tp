@startuml
' Reuses the loan diagrams' styling so all implementation diagrams look consistent.
!include loan-style.puml
hide circle
top to bottom direction
skinparam nodesep 45
skinparam ranksep 55

class SessionManager {
    --
    {field} +getSession(userIndex: int): Session
}

class Session {
    {field} -headcount: int
    --
    {field} +getHeadcount(): int
    {field} +getPreparation(): Preparation
}

class Preparation {
    --
    {field} +addItem(name: String, category: String,\n  quantityPerPerson: int, headcount: int): PreparationItem
    {field} +removeItem(userIndex: int, quantity: int): PreparationItem
    {field} +getItems(): List<PreparationItem>
}

class PreparationItem <<immutable>> {
    {field} -name: String
    {field} -category: String
    {field} -quantity: int
    --
}

class Inventory {
    --
    {field} +getAvailableQuantity(name: String, category: String): int
}

SessionManager -down-> "0..*" Session : -sessions\n{ordered} >
Session *-down-> Preparation : -preparation >
Preparation -down-> "0..*" PreparationItem : -items\n{ordered} >
Parser ..> Inventory : queries availability >
Parser ..> Preparation : reads requirements >
class Parser {
    --
}

note left of PreparationItem
  quantity is the total for the
  whole session, not per attendee.
end note

note top of Inventory
  Queried by name and category only
  when the list is displayed.
  No stock reference is stored.
end note
@enduml
