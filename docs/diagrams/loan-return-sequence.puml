@startuml
!include loan-style.puml
hide footbox
skinparam maxMessageSize 240

participant ":Parser" as Parser
participant ":LoanManager" as Manager
participant "records:ArrayList<LoanRecord>" as Loans
participant ":Inventory" as Inventory
participant "Ui" as Ui

[-> Parser : handleCommand("return 1", ...)
activate Parser
Parser -> Manager : returnLoan(1)
activate Manager
Manager -> Manager : closeLoanAndRestoreStock(1, RETURNED)
activate Manager
note over Manager
    Filter ACTIVE records; validate index.
    Resolve its permanent record position.
end note
Manager -> Loans : get(recordIndex)
activate Loans
Loans --> Manager : record
deactivate Loans
Manager -> Manager : closed = record.close(RETURNED, now)
Manager -> Inventory : restoreStock(name, category, quantity)
activate Inventory
note right of Inventory
    Merge matching stock or
    recreate missing entries.
    Check overflow before mutation.
end note
Inventory --> Manager : completed
deactivate Inventory
note over Manager, Loans
    If overflow rejects restoration,
    closure is skipped; the active loan
    and stock remain unchanged.
end note
Manager -> Loans : set(recordIndex, closed)
activate Loans
Loans --> Manager : record
deactivate Loans
Manager --> Manager : record.loan()
deactivate Manager
Manager --> Parser : loan
deactivate Manager
Parser -> Ui : showLoanReturned(loan)
activate Ui
Ui --> Parser : completed
deactivate Ui
[<-- Parser
deactivate Parser
@enduml
