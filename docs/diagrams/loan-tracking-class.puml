@startuml
!include loan-style.puml
hide circle
top to bottom direction
skinparam nodesep 45
skinparam ranksep 55

class LoanManager {
    {field} -nextLoanId: long
    --
    {field} +addLoan(loan: Loan): LoanAdditionResult
    {field} +returnLoan(userIndex: int): Loan
    {field} +deleteLoan(userIndex: int): Loan
    {field} +getLoanEntries(): List<LoanListEntry>
    {field} +getOverdueLoanEntries(): List<LoanListEntry>
    {field} +getLoanHistory(): List<LoanRecord>
    {field} +getReturnedLoans(): List<LoanRecord>
}

class LoanRecord <<record>> {
    {field} -loanId: long {readOnly}
    {field} -status: Status {readOnly}
    {field} -recordedAt: OffsetDateTime {readOnly}
    {field} -closedAt: OffsetDateTime {readOnly}
    --
    {field} +close(status: Status, timestamp: OffsetDateTime): LoanRecord
}

class Inventory {
    --
}
abstract class Clock <<Java API>> {
    --
}

class Loan {
    {field} -borrowerName: String
    {field} -borrowerPhone: String
    {field} -dueDate: LocalDate
    --
    {field} +isOverdue(today: LocalDate): boolean
}

class InventoryItem {
    {field} -name: String
    {field} -category: String
    {field} -quantity: int
    --
}

class Contact {
    --
}

LoanManager -left-> "1" Inventory : -inventory >
LoanManager -right-> "1" Clock : -clock >
LoanManager -down-> "0..*" LoanRecord : -records\n{creation order} >
LoanRecord --> "1" Loan : immutable details >
Loan *-left-> "1" InventoryItem : -item\n{private snapshot} >
Inventory -down-> "0..*" InventoryItem : available stock\n(grouped by category) >
Loan .right.> Contact : <<use>>\nvalidate copied values >

note bottom of LoanRecord
  ACTIVE -> RETURNED or VOIDED.
  IDs survive closure and restart.
  Active indices are filtered positions.
end note

note bottom of InventoryItem
  Loan snapshots and live stock
  are separate objects of this class.
end note
@enduml
